{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/guide", "destination": "/wikilot", "permanent": true },
    { "source": "/guide/:make", "destination": "/wikilot/:make", "permanent": true },
    { "source": "/guide/:make/:model", "destination": "/wikilot/:make/:model", "permanent": true },
    { "source": "/post", "destination": "/value", "permanent": true },
    { "source": "/post/:path*", "destination": "/value", "permanent": true },
    { "source": "/listing/:path*", "destination": "/wikilot", "permanent": true },
    { "source": "/category/:path*", "destination": "/wikilot", "permanent": true },
    { "source": "/manage/:path*", "destination": "/wikilot", "permanent": true }
  ],
  "rewrites": [
    { "source": "/admin/:path*", "destination": "/spa.html" },
    { "source": "/wikilot/:make/:model", "destination": "/spa.html" }
  ]
}
